# Copie este arquivo para .env e ajuste os valores.

# --- Aplicação ---------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=1
HOST=127.0.0.1
PORT=5000

# Endereço público usado nos links enviados por WhatsApp/SMS e no QR Code.
# Para testar o QR Code no celular, use o IP da sua máquina na rede local
# (ex.: http://192.168.0.10:5000) e rode com HOST=0.0.0.0.
BASE_URL=http://localhost:5000

# Mostra o código de verificação na tela (útil enquanto não há WhatsApp/SMS real)
MODO_DEMO=1
# Cria barbearias, barbeiros, clientes e agendamentos de exemplo ao iniciar
CARREGAR_DADOS_DEMO=1

# --- Mensagens (WhatsApp / SMS) ------------------------------------------------
# console = imprime no terminal e grava na tela "Mensagens" do painel
PROVEDOR_WHATSAPP=console   # console | twilio | meta
PROVEDOR_SMS=console        # console | twilio
# 1 = envia em segundo plano (fila com thread). Em produção, use RQ/Celery.
FILA_ASSINCRONA=0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO_SMS=
TWILIO_NUMERO_WHATSAPP=

# WhatsApp Cloud API (Meta). Confira a versão atual da Graph API.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_GRAPH_VERSAO=v21.0

# --- Lembretes automáticos ------------------------------------------------------
AGENDADOR_ATIVO=1
AGENDADOR_INTERVALO_SEGUNDOS=60

# --- Produção ----------------------------------------------------------------------
SESSION_COOKIE_SECURE=0
